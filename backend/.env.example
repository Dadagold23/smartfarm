# ASIIS backend configuration (Phase 1)
# Copy to .env and adjust. All values here are the defaults used by
# app.core.config.Settings when no environment override is present.

# Development default is SQLite so the platform runs with no external services.
# Production (Phase 6 infra) uses PostGIS: see docker-compose.yml.
DATABASE_URL=sqlite:///./agrosmart.db

# SECURITY: must be overridden in any deployed environment.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS origins for the frontend dev server
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Role granted to self-registered users (must exist in ROLE_CATALOG).
DEFAULT_SELF_REGISTRATION_ROLE=farm_manager

# ---------------------------------------------------------------------------
# Phase 2 — telemetry, fault detection, weather providers, MQTT
# ---------------------------------------------------------------------------

# No accepted reading for this long => device reported stale (stale_data fault).
TELEMETRY_STALE_MINUTES=120
# Device timestamps further in the future than this are rejected.
TELEMETRY_MAX_FUTURE_SKEW_MINUTES=5
# N consecutive identical values of one metric => flatline fault.
FLATLINE_CONSECUTIVE_READINGS=3
# Readings accepted per ingestion batch request.
TELEMETRY_MAX_BATCH=500
# Hardware SPEC operating ranges used for out_of_range faults (JSON, partial
# overrides allowed). Empty = defaults in app/services/telemetry_service.py.
# These are device specification limits, not agronomic thresholds.
#TELEMETRY_OPERATING_RANGES={"wx.temperature_c": [-20, 50]}

# Forecast provider: simulated | open_meteo | open_weather_map
WEATHER_PROVIDER=simulated
WEATHER_FORECAST_DAYS=7
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_WEATHER_MAP_BASE_URL=https://api.openweathermap.org/data/3.0
# Key-licensed provider extension point: leave empty and open_weather_map
# reports itself unconfigured. Never commit a key.
OPEN_WEATHER_MAP_API_KEY=
WEATHER_PROVIDER_TIMEOUT_S=10

# Real MQTT broker channel. False (or broker unreachable at startup) = the
# in-process fallback bus with the identical topic schema.
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_CA_CERTS=
MQTT_BASE_TOPIC=asiis/v1
